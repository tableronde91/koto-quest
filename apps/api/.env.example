# Copier en .env (npm run setup le fait automatiquement)
DATABASE_URL="postgresql://koto:koto@localhost:5432/koto?schema=public"
PORT=3000
# Origine du front (CORS + liens dans les e-mails / notifications)
WEB_ORIGIN="http://localhost:5173"
# Mettre true derrière HTTPS en production (cookie Secure)
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Planificateur des rappels (désactivé dans les tests)
SCHEDULER_ENABLED=true
# Clés VAPID pour Web Push : générées par `npm run vapid -w @koto/api`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@koto-quest.local"
# Production : nombre de proxys inverses devant l'API (IP réelle des joueurs pour l'anti-abus)
TRUST_PROXY=
# Production : dossier du site compilé servi par l'API (apps/web/dist)
WEB_DIST=
# E-mails réels (mot de passe oublié) ; vide = écrits dans les logs
SMTP_URL=
MAIL_FROM="Koto Quest <no-reply@koto-quest.local>"
