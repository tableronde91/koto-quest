# ── Koto Quest en production ── copier en .env à côté de docker-compose.prod.yml, puis remplir.
# Ne jamais versionner le fichier .env.

# Nom de domaine du site (sans https://)
DOMAIN=koto-quest.exemple.fr

# Mot de passe de la base PostgreSQL : long et aléatoire (ex. `openssl rand -hex 24`)
POSTGRES_PASSWORD=

# Durée de validité d'une session (jours)
SESSION_TTL_DAYS=30

# Notifications push (défis de la journée) : générer avec
#   docker compose -f docker-compose.prod.yml run --rm --no-deps app node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@exemple.fr

# E-mails (mot de passe oublié). Vide = les liens sont seulement écrits dans les logs.
# Exemple : smtps://utilisateur%40exemple.fr:motdepasse@ssl0.ovh.net:465
SMTP_URL=
MAIL_FROM=Koto Quest <no-reply@exemple.fr>

# Rappels planifiés (une seule instance de l'application)
SCHEDULER_ENABLED=true
